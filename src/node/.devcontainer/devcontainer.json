// Dev Container config dropped into a project by the `node` template.
// Reference: https://containers.dev/implementors/json_reference
{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "customizations": {
    "vscode": {
      // Versions intentionally unpinned. `extensions.autoUpdate` is disabled
      // below, so each machine freezes at whatever it first installs — stable
      // in practice without version strings to maintain.
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "GraphQL.vscode-graphql-syntax",
        "GraphQL.vscode-graphql",
        "oxc.oxc-vscode",
        "vitest.explorer",
        "webpro.vscode-knip"
      ],
      "settings": {
        "chat.disableAIFeatures": true,
        "extensions.autoUpdate": false,
        "extensions.autoCheckUpdates": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  },

  // Lifecycle commands are guarded so applying this template into an empty or
  // non-JS repo does not fail on first build.
  "postCreateCommand": "bash -c 'if [ -f package.json ]; then pnpm i; fi; if [ -f .pre-commit-config.yaml ]; then prek install; fi'",
  "updateContentCommand": "bash -c 'rm -rf .cache; if [ -f package.json ]; then pnpm i; fi; if [ -f .pre-commit-config.yaml ]; then prek install; fi'",

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "DISABLE_AUTOUPDATER": "1"
  },

  // ── Host credential sharing (optional, OFF by default) ──────────────────
  // By default this template mounts no host paths, so it starts cleanly on any
  // host and in any Dev Containers flow.
  //
  // To reuse your host Claude Code + gh credentials inside the container,
  // authenticate once on the host (`gh auth login`, and sign in to Claude Code)
  // so the source paths exist, then uncomment the three bind mounts below.
  //
  // Heads up if you commit them: everyone who opens this repo in a container
  // then depends on the same host paths. A teammate who hasn't authenticated on
  // their host will get `bind source path does not exist` on start — they fix it
  // by authenticating on the host and rebuilding, or by re-commenting the mounts.
  "mounts": [
    // ── Optional host-credential mounts (see note above) ──
    // Claude Code credentials — read-only so container processes can't tamper
    // with host auth.
    // "source=${localEnv:HOME}/.claude.json,target=/home/node/.claude.json,type=bind,readonly",
    // Claude Code working state (projects, todos, memory) — must be writable.
    // "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind",
    // GitHub CLI credentials — read-only; re-auth on the host with `gh auth login`.
    // "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind,readonly",

    // Per-project named volume for persistent zsh history across rebuilds.
    // Derived from the folder name so each project gets its own history.
    "source=${localWorkspaceFolderBasename}-zsh-history,target=/commandhistory,type=volume"
  ],

  // Connect as the non-root `node` user (the Dockerfile's default USER). Set to
  // "root" to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "node"
}
