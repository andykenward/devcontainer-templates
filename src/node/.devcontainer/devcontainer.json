// Dev Container config dropped into a project by the `node` template.
// Reference: https://containers.dev/implementors/json_reference
{
  "name": "${localWorkspaceFolderBasename}",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "customizations": {
    "vscode": {
      // Versions intentionally unpinned. `extensions.autoUpdate` is disabled
      // below, so each machine freezes at whatever it first installs — stable
      // in practice without version strings to maintain.
      "extensions": [
        "anthropic.claude-code",
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "GraphQL.vscode-graphql-syntax",
        "GraphQL.vscode-graphql",
        "oxc.oxc-vscode",
        "vitest.explorer",
        "webpro.vscode-knip"
      ],
      "settings": {
        "chat.disableAIFeatures": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  },

  // Lifecycle commands are guarded so applying this template into an empty or
  // non-JS repo does not fail on first build.
  "postCreateCommand": "bash -c 'if [ -f package.json ]; then pnpm i; fi; if [ -f .pre-commit-config.yaml ]; then prek install; fi'",
  "updateContentCommand": "bash -c 'rm -rf .cache; if [ -f package.json ]; then pnpm i; fi; if [ -f .pre-commit-config.yaml ]; then prek install; fi'",

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "DISABLE_AUTOUPDATER": "1"
  },

  // Named volumes, not host paths: the container starts cleanly on any host and
  // in any Dev Containers flow, and nothing here depends on your host layout.
  "mounts": [
    // ── Optional host-credential mount (OFF by default) ──
    // Reuse the GitHub CLI login from your host: run `gh auth login` on the host
    // first — a bind mount requires its source to already exist — then uncomment
    // the line below. Read-only, so container processes can't tamper with host
    // auth. Claude Code needs no equivalent: it signs in inside the container and
    // the volume below keeps it signed in.
    //
    // Heads up if you commit it: everyone who opens this repo in a container then
    // depends on the same host path. A teammate who hasn't run `gh auth login`
    // will get `bind source path does not exist` on start.
    // "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind,readonly",

    // Claude Code state — the auth token, settings, session transcripts, auto
    // memory and prompt history all live under CLAUDE_CONFIG_DIR (set above), so
    // this volume is what stops a rebuild signing you out and losing your
    // sessions. ${devcontainerId} is unique to this workspace, so two projects
    // never share one volume. Reset it with `docker volume rm` — nothing inside
    // the container clears it. https://code.claude.com/docs/en/devcontainer
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",

    // Persistent zsh history across rebuilds. Keyed by ${devcontainerId} for the
    // same reason as the volume above: the folder name is not unique, and shell
    // history routinely contains tokens pasted into `curl` or `gh` commands, so
    // two unrelated projects that happen to share a folder name must not share
    // one history file.
    "source=zsh-history-${devcontainerId},target=/home/node/.commandhistory,type=volume"
  ],

  // Connect as the non-root `node` user (the Dockerfile's default USER). Set to
  // "root" to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "node"
}
