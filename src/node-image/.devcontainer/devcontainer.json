// Dev Container config dropped into a project by the `node-image` template.
// Reference: https://containers.dev/implementors/json_reference
//
// This is deliberately tiny. The image was built with `devcontainer build`, so
// the extensions, editor settings, lifecycle commands, containerEnv, remoteUser
// and both named volumes (Claude Code state, zsh history) all travel with it in
// a `devcontainer.metadata` label and are applied automatically. See NOTES.md.
{
  "name": "${localWorkspaceFolderBasename}",
  "image": "ghcr.io/andykenward/devcontainer-images/node:2",

  // ── Optional host-credential mount (OFF by default) ──────────────────────
  // This lives here rather than in the image because JSONC comments are not
  // JSON, so a commented-out mount cannot be carried in the image's metadata
  // label. Mounts declared here are additive to the image's own.
  //
  // Reuse the GitHub CLI login from your host. Run `gh auth login` on the host
  // first — a bind mount requires its source to already exist — then uncomment
  // it. Read-only, so container processes can't tamper with host auth. Claude
  // Code needs no equivalent: it signs in inside the container, and the image's
  // per-project `claude-code-config-${devcontainerId}` volume keeps it signed in
  // across rebuilds.
  //
  // Heads up if you commit it: everyone who opens this repo in a container then
  // depends on the same host path. A teammate who hasn't run `gh auth login`
  // will get `bind source path does not exist` on start.
  "mounts": [
    // "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind,readonly"
  ]
}
