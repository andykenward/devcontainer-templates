{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>andykenward/renovate-config"
  ],
  "customManagers": [
    {
      "description": "devcontainer CLI pinned in the test workflow (npm install -g @devcontainers/cli@<version>)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["npm install -g @devcontainers/cli@(?<currentValue>\\S+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@devcontainers/cli"
    },
    {
      "description": "syft pinned in anchore/sbom-action (syft-version: <version>)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["syft-version:\\s*[\"']?(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "anchore/syft"
    },
    {
      "description": "cosign pinned in sigstore/cosign-installer (cosign-release: <version>)",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["cosign-release:\\s*[\"']?(?<currentValue>v[\\d.]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sigstore/cosign"
    }
  ]
}
